#!/usr/bin/env bash
# Corre una rutina del harness sobre los proyectos activos de projects.toon.
# Uso: harness-run daily|weekly|friday [proyecto]   (lo llama launchd; también se puede correr a mano)
# Con HARNESS_FALLBACK=1 corre como respaldo de otra PC: después del pull, saltea cada proyecto
# donde la rutina de hoy ya corrió (lo llama el Programador de tareas de Windows).
set -uo pipefail

WS="$HOME/claude-workspace"
# Lo leen las guardas (hooks/guards.py): una rutina sin supervisión no puede reescribir CLAUDE.md, .claude/ ni el harness.
export HARNESS_UNATTENDED=1
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/mingw64/bin:/usr/bin:/bin"
FALLBACK="${HARNESS_FALLBACK:-0}"
# Git no ejecuta nada que traiga el repo: sin fsmonitor en ningún comando; sin hooks en el pull ni en lo que corre Claude
# (un hook plantado en .git/hooks correría con el usuario). El push conserva los hooks: el pre-push publica el espejo.
NOHOOKS="$WS/logs/.nohooks"   # directorio que no existe: sin hooks
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.fsmonitor GIT_CONFIG_VALUE_0=false
VENV_PY="$WS/harness/.venv/bin/python"
[ -e "$WS/harness/.venv/Scripts/python.exe" ] && VENV_PY="$WS/harness/.venv/Scripts/python.exe"
ROUTINE="${1:?uso: harness-run daily|weekly|friday [proyecto]}"
ONLY="${2:-}"
TODAY="$(date +%F)"
LOG="$WS/logs/$TODAY-$ROUTINE.log"
mkdir -p "$WS/logs"

# Un solo lock para todas las rutinas: escriben en los mismos repos. Se espera turno hasta 90 min.
LOCK="$WS/logs/.lock"
waited=0
until mkdir "$LOCK" 2>/dev/null; do
  if [ "$waited" -ge 5400 ]; then echo "$(date -Iseconds) $ROUTINE: otra rutina sigue corriendo después de 90 min, se cancela" >>"$LOG"; exit 0; fi
  sleep 60; waited=$((waited + 60))
done
trap 'rmdir "$LOCK"' EXIT

MCP_READ="mcp__claude_ai_Google_Calendar__list_events,mcp__claude_ai_Google_Calendar__get_event,\
mcp__claude_ai_Google_Drive__search_files,mcp__claude_ai_Google_Drive__get_file_metadata,\
mcp__claude_ai_Google_Drive__read_file_content,mcp__claude_ai_Google_Drive__download_file_content,\
mcp__claude_ai_Gmail__search_threads,mcp__claude_ai_Gmail__get_thread,mcp__claude_ai_Gmail__get_message,\
mcp__claude_ai_Slack__slack_read_channel,mcp__claude_ai_Slack__slack_read_thread,\
mcp__claude_ai_Slack__slack_search_channels,mcp__claude_ai_Slack__slack_search_public_and_private,\
mcp__claude_ai_Slack__slack_search_users,mcp__claude_ai_Slack__slack_read_user_profile,\
mcp__claude_ai_ClickUp__clickup_filter_tasks,mcp__claude_ai_ClickUp__clickup_get_task,\
mcp__claude_ai_ClickUp__clickup_get_task_comments,mcp__claude_ai_ClickUp__clickup_search,\
mcp__claude_ai_ClickUp__clickup_resolve_assignees,mcp__claude_ai_ClickUp__clickup_get_time_entries,\
mcp__claude_ai_ClickUp__clickup_get_list,mcp__claude_ai_ClickUp__clickup_get_folder"
LOCAL_TOOLS="Read,Write,Edit,Glob,Grep,Bash(git add *),Bash(git commit *),Bash(git status *),\
Bash(git log *),Bash(git diff *),Bash(shasum *),Bash(mkdir *),Bash(date *),Bash(ls *),\
Bash(py $HOME/claude-workspace/harness/skills/daily-report/render.py *),\
Bash(python3 $HOME/claude-workspace/harness/skills/daily-report/render.py *)"

log() { echo "$(date -Iseconds) $*" >>"$LOG"; }

active_projects() {
  awk 'NR > 1 && NF { sub(/^[ \t]+/, ""); print }' "$WS/projects.toon" |
    while IFS=, read -r name path active; do
      [ "$active" = "true" ] || continue
      [ -n "$ONLY" ] && [ "$name" != "$ONLY" ] && continue
      echo "$name|${path/#\~/$HOME}"
    done
}

# La política de la org pone defaultMode=plan, y en plan una rutina no puede escribir. Se usa "default" + allowlist acotada; nunca bypass.
run_claude() {  # $1 dir, $2 prompt, $3 allowed tools
  # </dev/null: el loop de proyectos recibe la lista por stdin y claude -p se la consumía (solo corría el primero).
  (cd "$1" && export GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_1=core.hooksPath GIT_CONFIG_VALUE_1="$NOHOOKS" && claude -p "$2" --permission-mode default --allowedTools "$3" --max-turns 80) </dev/null >>"$LOG" 2>&1
}

# Los repos se trabajan desde más de una PC: se trae lo remoto antes de escribir y se sube al terminar.
# Un pull que no rebasea limpio no se resuelve acá: se aborta, se registra y la rutina sigue en local.
git_sync() {  # $1 dir, $2 pull|push
  git -C "$1" remote get-url origin >/dev/null 2>&1 || return 0
  if [ "$2" = pull ]; then
    git -C "$1" -c core.hooksPath="$NOHOOKS" pull --rebase --autostash -q >>"$LOG" 2>&1 || { git -C "$1" rebase --abort >/dev/null 2>&1; log "$1: pull falló, se sigue con lo local"; }
  else
    # Rebase justo antes de subir: el remoto avanza mientras la rutina corre (otra PC, commits manuales).
    git -C "$1" -c core.hooksPath="$NOHOOKS" pull --rebase --autostash -q >>"$LOG" 2>&1 || { git -C "$1" rebase --abort >/dev/null 2>&1; log "$1: rebase previo al push falló"; return 1; }
    git -C "$1" push -q >>"$LOG" 2>&1 || { log "$1: push falló"; return 1; }
  fi
}

# Un fallo que la rutina no puede resolver sola (push) no se esconde detrás de exit=0: queda en run-status.
flag_failure() {  # $1 dir, $2 clave (git-config|push)
  local f="$1/.harness/run-status"
  echo "$2=fallo" >>"$f"
  awk -F= '$1=="exit" && $2=="0" { print "exit=3"; next } { print }' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
}

# Qué deja cada rutina en el repo del proyecto cuando corrió hoy. Se mira después del pull.
already_ran() {  # $1 dir
  case "$ROUTINE" in
    daily)  [ -f "$1/status/$TODAY.md" ] ;;
    weekly) [ -n "$(git -C "$1" log --since="$TODAY 00:00" --grep='^harness(consolidate)' --format=%h 2>/dev/null)" ] ;;
    friday) [ -n "$(git -C "$1" log --since="$TODAY 00:00" --grep='^harness(hours)' --format=%h -- time 2>/dev/null)" ] ;;
  esac
}

mark() {  # $1 dir, $2 exit code
  mkdir -p "$1/.harness"
  printf 'routine=%s\nat=%s\nexit=%s\nlog=%s\n' "$ROUTINE" "$(date -Iseconds)" "$2" "$LOG" >"$1/.harness/run-status"
}

case "$ROUTINE" in
  daily)  PROMPT="MODO DESATENDIDO. SIN DM. El proyecto es el del directorio actual. Ejecutá en orden las skills drive-mirror (solo bajar de Drive), project-ingest, project-status y daily-report (en el modo que indique el role de ~/claude-workspace/harness/config.toml; sin abrir el HTML), siguiendo ~/claude-workspace/harness/reference/conventions.md." ;;
  weekly) PROMPT="MODO DESATENDIDO. El proyecto es el del directorio actual. Ejecutá la skill project-consolidate, siguiendo ~/claude-workspace/harness/reference/conventions.md." ;;
  friday) PROMPT="MODO DESATENDIDO. El proyecto es el del directorio actual. Ejecutá la skill weekly-hours en modo preparar (no cargues nada en ClickUp)." ;;
  *) echo "rutina desconocida: $ROUTINE" >&2; exit 2 ;;
esac

log "inicio $ROUTINE"
ran=0
while IFS='|' read -r name dir; do
  [ -d "$dir" ] || { log "$name: no existe $dir"; continue; }
  git_sync "$dir" pull
  if [ "$FALLBACK" = 1 ] && already_ran "$dir"; then log "$name: ya corrió hoy en la otra PC, se saltea"; continue; fi
  log "$name: corriendo"
  # La config local de git ejecuta código (core.sshCommand, hooksPath, alias): si la rutina la cambió, no se pushea.
  cfg_before="$(git -C "$dir" config --local --list 2>/dev/null | sort | cksum)"
  run_claude "$dir" "$PROMPT" "$MCP_READ,$LOCAL_TOOLS"
  rc=$?
  cfg_after="$(git -C "$dir" config --local --list 2>/dev/null | sort | cksum)"
  mark "$dir" "$rc"
  "$([ -x "$VENV_PY" ] && echo "$VENV_PY" || command -v py || command -v python3)" -X utf8 "$WS/harness/scripts/harness_lint.py" "$dir" >>"$LOG" 2>&1 || log "$name: lint con errores"
  if [ "$cfg_before" != "$cfg_after" ]; then
    log "$name: la configuración local de git cambió durante la rutina, no se pushea"
    flag_failure "$dir" git-config
  else
    git_sync "$dir" push || flag_failure "$dir" push
  fi
  log "$name: fin (exit $rc)"
  ran=$((ran + 1))
done < <(active_projects)

if [ "$ROUTINE" = "weekly" ] && { [ "$FALLBACK" != 1 ] || [ "$ran" -gt 0 ]; }; then
  log "aws-radar y harness-evolve"
  ws_cfg_before="$(git -C "$WS" config --local --list 2>/dev/null | sort | cksum)"
  run_claude "$WS" "MODO DESATENDIDO. Ejecutá la skill aws-radar y después la skill harness-evolve." \
    "$LOCAL_TOOLS,WebSearch,WebFetch(domain:aws.amazon.com),WebFetch(domain:docs.aws.amazon.com)"
fi

git_sync "$WS" pull
if [ "${ws_cfg_before:-}" != "" ] && [ "$ws_cfg_before" != "$(git -C "$WS" config --local --list 2>/dev/null | sort | cksum)" ]; then
  log "$WS: la configuración local de git cambió durante la rutina, no se pushea"
else
  git_sync "$WS" push
fi
log "fin $ROUTINE ($ran proyectos)"
